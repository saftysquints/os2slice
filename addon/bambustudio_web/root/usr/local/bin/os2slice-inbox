#!/usr/bin/env python3
"""Open files os2slice drops in /share/os2slice/inbox, and report who's viewing.

Every few seconds:
- writes /share/os2slice/web-studio.json: {"viewers": n, "updated": unix time}
  (n = browser connections to the Selkies stream on 127.0.0.1:8082), plus
  "failing", "last_exit", "failures", "failing_since" and "next_try" while the
  app keeps exiting right after a restart;
- restarts Bambu Studio when it isn't running, backing off when it won't stay up;
- moves each finished *.3mf from the inbox into /config/os2slice-files and opens
  it in the running Bambu Studio (single instance, so it joins the open window).

The defaults are the web Bambu Studio's; the web OrcaSlicer image (addon/orcaslicer_web)
sets the OS2SLICE_* variables below for its own app, inbox and status file.
"""

from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
import threading
import time
from pathlib import Path

ENV = os.environ.get
INBOX = Path(ENV("OS2SLICE_INBOX", "/share/os2slice/inbox"))
STATUS = Path(ENV("OS2SLICE_STATUS", "/share/os2slice/web-studio.json"))
DIAG_PREFIX = ENV("OS2SLICE_DIAG_PREFIX", "/share/os2slice/web-studio")
PROCS = Path(f"{DIAG_PREFIX}-processes.txt")  # diagnostics, refreshed every 30 s
APP_LOG = Path(f"{DIAG_PREFIX}-app.log")  # the app's own output
DIAG = Path(f"{DIAG_PREFIX}-diag.txt")  # handoff diagnostics, after each launch
SESSION_VARS = ("WAYLAND_DISPLAY", "DISPLAY", "XDG_RUNTIME_DIR", "DBUS_SESSION_BUS_ADDRESS",
                "XDG_SESSION_TYPE", "XDG_CURRENT_DESKTOP", "LANG", "PATH")  # fmt: skip
RESTART_AFTER = 20  # seconds the desktop runs without Bambu Studio before we start it
KEEP = Path("/config/os2slice-files")
CONF = Path(ENV("OS2SLICE_APP_CONF", "/config/.config/BambuStudioBeta/BambuStudio.conf"))
APP = ENV("OS2SLICE_APP", "/opt/bambustudio/AppRun")
APP_PROC = ENV("OS2SLICE_APP_PROC", "bin/bambu-studio")  # pgrep -f pattern of the app
APP_NAME = ENV("OS2SLICE_APP_NAME", "Bambu Studio")
KEEP_DAYS = 7
QUICK_EXIT = 30  # seconds: a restart that exits sooner counts as a failure
MAX_QUICK = 3  # quick failures in a row before backing off
MAX_DELAY = 1800  # seconds: the longest wait between restarts


class Backoff:
    """Counts watchdog restarts that exit within QUICK_EXIT and spaces out the next ones.

    On 2026-10-02 Bambu Studio exited with status 255 right after every restart, and
    the watchdog retried once a minute for 4 days with nothing visible but "unavailable".
    """

    def __init__(self) -> None:
        self.reset()

    @property
    def failing(self) -> bool:
        return self.failures >= MAX_QUICK

    def delay(self) -> float:
        """Seconds to wait before the next restart: 0 (normal pace) until MAX_QUICK."""
        if not self.failing:
            return 0.0
        return float(min(60 * 2 ** (self.failures - MAX_QUICK), MAX_DELAY))

    def may_launch(self, now: float) -> bool:
        return now >= self.next_try

    def reset(self) -> None:
        """The app is up (a restart survived QUICK_EXIT, or something else started it)."""
        self.failures = 0
        self.last_exit: int | None = None
        self.failing_since: float | None = None
        self.next_try = 0.0
        self._said_delay: float | None = None

    def exited(self, status: int, ran: float, now: float) -> str | None:
        """A watchdog restart ended; returns a line for the supervisor log, or None."""
        if ran >= QUICK_EXIT:
            self.reset()
            return None
        self.failures += 1
        self.last_exit = status
        if self.failing_since is None:
            self.failing_since = now
        delay = self.delay()
        self.next_try = now + delay
        if not self.failing or delay == self._said_delay:
            return None  # not failing yet, or already said so
        self._said_delay = delay
        when = f"{delay / 60:.0f} min" if delay >= 60 else f"{delay:.0f} s"
        return (
            f"os2slice-inbox: {APP_NAME} exited with status {status} after {ran:.1f} s, "
            f"{self.failures} times in a row; next try in {when}"
        )

    def fields(self) -> dict[str, object]:
        """The status file's extra keys; empty unless failing."""
        if not self.failing:
            return {}
        return {
            "failing": True, "last_exit": self.last_exit, "failures": self.failures,
            "failing_since": int(self.failing_since or 0), "next_try": int(self.next_try),
        }  # fmt: skip


BACKOFF = Backoff()
LAUNCHED: list[tuple[subprocess.Popen[bytes], float, bool]] = []  # (proc, started, watchdog)


def viewers() -> int:
    out = subprocess.run(
        ["ss", "-Htn", "state", "established", "( sport = :8082 )"],
        capture_output=True, text=True, check=False,
    ).stdout
    return sum(1 for line in out.splitlines() if line.strip())


def app_running() -> bool:
    out = subprocess.run(["pgrep", "-f", APP_PROC], capture_output=True, check=False)
    return out.returncode == 0


def write_status(n: int) -> None:
    tmp = STATUS.with_suffix(".tmp")
    data = {"viewers": n, "app_running": app_running(), "updated": int(time.time())}
    data.update(BACKOFF.fields())
    tmp.write_text(json.dumps(data))
    os.replace(tmp, STATUS)


def write_processes() -> None:
    out = subprocess.run(
        ["ps", "-eo", "pid,etimes,rss,args"], capture_output=True, text=True, check=False
    ).stdout
    PROCS.write_text(out[:20000])


def set_single_instance() -> None:
    if not CONF.exists():
        return  # first run: the app writes it; next start sets the flag
    try:
        data = json.loads(CONF.read_text(), strict=False)  # OrcaSlicer's may hold raw tabs
        if data.setdefault("app", {}).get("single_instance") is not True:
            data["app"]["single_instance"] = True
            CONF.write_text(json.dumps(data, indent=4))
            shutil.chown(CONF, "abc", "abc")
    except (ValueError, OSError) as e:
        print(f"os2slice-inbox: can't set single_instance: {e}", flush=True)


def session_bus() -> str | None:
    """The session bus the running app joined (via D-Bus X11 autolaunch).

    The app hands a second launch's files to the open window over this bus.
    A launch from here can't autolaunch-find it (dbus-launch fails to reach the X
    display), but autolaunch also records the address in ~/.dbus/session-bus.
    """
    files = sorted(Path("/config/.dbus/session-bus").glob("*-0"), key=lambda f: f.stat().st_mtime)
    for line in files[-1].read_text().splitlines() if files else []:
        if line.startswith("DBUS_SESSION_BUS_ADDRESS="):
            return line.split("=", 1)[1].strip().strip("'")
    return None


def session_env() -> dict[str, str] | None:
    """The desktop session's environment, copied from the running labwc compositor.

    Read as user abc: root in an unprivileged container can't read another user's
    /proc/<pid>/environ. In this Wayland image the app's display is :0 on wayland-0,
    not the image's DISPLAY=:1.
    """
    pid = subprocess.run(["pgrep", "-x", "labwc"], capture_output=True, text=True).stdout.split()
    if not pid:
        return None
    raw = subprocess.run(
        ["s6-setuidgid", "abc", "cat", f"/proc/{pid[0]}/environ"], capture_output=True, check=False
    ).stdout
    found = dict(
        item.split("=", 1) for item in raw.decode(errors="replace").split("\0") if "=" in item
    )
    env = {k: found[k] for k in SESSION_VARS if k in found}
    env["HOME"] = "/config"
    if "DBUS_SESSION_BUS_ADDRESS" not in env and (bus := session_bus()):
        env["DBUS_SESSION_BUS_ADDRESS"] = bus
    return env if "WAYLAND_DISPLAY" in env or "DISPLAY" in env else None


def _sh(cmd: str, env: dict[str, str] | None = None) -> str:
    r = subprocess.run(["s6-setuidgid", "abc", "sh", "-c", cmd], capture_output=True,
                       text=True, env=env, check=False, timeout=20)  # fmt: skip
    return (r.stdout + r.stderr)[-6000:]


def diagnose(env: dict[str, str]) -> None:
    """Why a launch didn't reach the open window: config, D-Bus, Bambu Studio's logs."""
    time.sleep(6)
    pid = subprocess.run(["pgrep", "-of", APP_PROC], capture_output=True, text=True)
    first = pid.stdout.split()[0] if pid.stdout.split() else ""
    parts = [
        f"=== {time.ctime()}",
        "--- config dir\n" + _sh(f"ls -d '{CONF.parent}' 2>&1"),
        "--- single_instance\n" + _sh(f"grep -H single_instance '{CONF}'"),
        "--- dbus files\n" + _sh("ls -la /config/.dbus/session-bus 2>&1; cat /config/.dbus/session-bus/* 2>&1"),
        f"--- env keys of {APP_NAME} {first}\n"
        + _sh(f"tr '\\0' '\\n' < /proc/{first}/environ | grep -E '^(DBUS|DISPLAY|WAYLAND|XDG)'"),
        "--- dbus names (launch env)\n" + _sh(
            "dbus-send --session --print-reply --dest=org.freedesktop.DBus / "
            "org.freedesktop.DBus.ListNames 2>&1 | grep -i -E 'string|error'", env),
        "--- newest log lines\n" + _sh(
            f"for f in $(ls -t '{CONF.parent}'/log/* 2>/dev/null | head -2); do "
            "echo \"## $f\"; grep -i -E 'instance|dbus|message|load|error' \"$f\" | tail -40; done"),
    ]
    DIAG.write_text("\n".join(parts) + "\n")


def launch(args: list[str]) -> bool:
    env = session_env()
    if env is None:
        print("os2slice-inbox: no desktop session yet", flush=True)
        return False
    with APP_LOG.open("ab") as log:
        log.write(f"\n--- {time.ctime()} launching {args} with {sorted(env)}\n".encode())
        proc = subprocess.Popen(
            ["s6-setuidgid", "abc", APP, *args],
            env=env, stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT,
            start_new_session=True,
        )
    # Kept so reap() can log the exit status and judge watchdog restarts. File opens
    # are single-instance handoffs that exit quickly by design: never failures.
    LAUNCHED.append((proc, time.time(), not args))
    if args:
        threading.Thread(target=diagnose, args=(env,), daemon=True).start()
    return True


def reap() -> None:
    """Log launches that ended; feed watchdog restarts to BACKOFF."""
    now = time.time()
    for item in list(LAUNCHED):
        proc, started, watchdog = item
        status = proc.poll()
        if status is None:
            if watchdog and now - started >= QUICK_EXIT and BACKOFF.failures:
                app_up()  # it stayed up
            continue
        LAUNCHED.remove(item)
        ran = now - started
        with APP_LOG.open("ab") as log:
            log.write(f"--- exited with status {status} after {ran:.1f} s\n".encode())
        if not watchdog:
            continue
        if ran < QUICK_EXIT and app_running():
            continue  # the launcher handed off to a running app: not a failure
        was_failing = BACKOFF.failing
        if line := BACKOFF.exited(status, ran, now):
            print(line, flush=True)
        elif was_failing and not BACKOFF.failing:
            print(f"os2slice-inbox: {APP_NAME} is up again", flush=True)


def app_up() -> None:
    if BACKOFF.failing:
        print(f"os2slice-inbox: {APP_NAME} is up again", flush=True)
    BACKOFF.reset()


def watchdog_alive() -> bool:
    return any(w and p.poll() is None for p, _, w in LAUNCHED)


def open_file(path: Path) -> None:
    if launch([str(path)]):
        print(f"os2slice-inbox: opened {path.name}", flush=True)


def take_inbox() -> None:
    for f in sorted(INBOX.glob("*.3mf")):
        if not f.is_file() or f.is_symlink():
            continue
        dest = KEEP / f.name
        shutil.move(str(f), dest)
        shutil.chown(dest, "abc", "abc")
        open_file(dest)


def prune() -> None:
    cutoff = time.time() - KEEP_DAYS * 86400
    for f in KEEP.glob("*.3mf"):
        if f.stat().st_mtime < cutoff:
            f.unlink(missing_ok=True)


def main() -> int:
    if "--set-single-instance" in sys.argv:
        set_single_instance()
        return 0
    INBOX.mkdir(parents=True, exist_ok=True)
    KEEP.mkdir(parents=True, exist_ok=True)
    last_prune = 0.0
    last_ps = 0.0
    missing_since: float | None = None
    while True:
        try:
            # Watchdog: keep Bambu Studio running on the desktop.
            reap()
            running = app_running()
            if running and not watchdog_alive():
                app_up()  # up without a restart of ours (the image's autostart)
            if running or not session_env():
                missing_since = None
            elif missing_since is None:
                missing_since = time.time()
            elif time.time() - missing_since > RESTART_AFTER and BACKOFF.may_launch(time.time()):
                if not BACKOFF.failing:  # while failing, reap() says it once per delay
                    print(f"os2slice-inbox: {APP_NAME} isn't running; starting it", flush=True)
                launch([])
                missing_since = time.time() + 40  # give it time to come up
            write_status(viewers())
            if time.time() - last_ps > 30:
                write_processes()
                last_ps = time.time()
            take_inbox()
            if time.time() - last_prune > 3600:
                prune()
                last_prune = time.time()
        except OSError as e:
            print(f"os2slice-inbox: {e}", flush=True)
        time.sleep(2)


if __name__ == "__main__":
    sys.exit(main())
